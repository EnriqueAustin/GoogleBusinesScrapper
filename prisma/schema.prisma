// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            Int      @id @default(autoincrement())
  name          String
  category      String?
  address       String?
  city          String?
  phone         String?
  website       String?
  hasWebsite    Boolean  @default(false)
  rating        Float?
  reviewCount   Int?
  socials       String?
  emails        String?
  websiteStatus String?
  techStack     String?
  seoStatus     String?
  leadScore     Int      @default(0)
  notes         String?
  tags          String?
  customFields  Json?
  query         String?
  scrapedAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // CRM Sales Pipeline Fields
  crmStatus          String   @default("new")     // new | attempting | connected | qualified | disqualified | closed_won | closed_lost
  pipelineId         String?
  pipeline           Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId            String?
  stage              Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  winProbability     Int?      @default(0)
  dealValue          Float?    @map("estimatedValue")

  callCount          Int      @default(0)
  lastCalledAt       DateTime?
  nextFollowUp       DateTime?
  qualificationNotes String?
  setupFee           Float?
  monthlyFee         Float?
  websitePainPoints  String?
  siteStatus         String   @default("none")     // none | demo | full

  // Relations
  logs          LeadLog[]
  calls         CallLog[] // @deprecated - migrating to activities
  activities    Activity[]

  @@unique([name, address])
  @@index([hasWebsite])
  @@index([query])
  @@index([category])
  @@index([rating])
  @@index([leadScore])
  @@index([city])
  @@index([crmStatus])
  @@index([pipelineId])
  @@index([stageId])
  @@index([nextFollowUp])
  @@index([siteStatus])
}

model LeadLog {
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([leadId])
}

model CallLog {
  // @deprecated - use Activity instead
  id        Int      @id @default(autoincrement())
  leadId    Int
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   @default("call") // call, email, note
  outcome   String   // answered | voicemail | no_answer | callback | interested | not_interested | left_message
  notes     String?
  duration  Int?     // seconds
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Activity {
  id          String   @id @default(uuid())
  leadId      Int
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String   @default("call") // call | email | note | meeting | system
  outcome     String?  // e.g. answered, voicemail, etc.
  notes       String?
  duration    Int?     // seconds
  dueDate     DateTime?
  assignedTo  String?  // For future multi-user
  isDone      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([leadId])
  @@index([type])
  @@index([dueDate])
  @@index([isDone])
}

model Query {
  id        String   @id @default(uuid())
  query     String   @unique
  scrapedAt DateTime @default(now())
}

model Job {
  id           String    @id @default(uuid())
  query        String
  status       String    @default("waiting")
  resultsCount Int       @default(0)
  durationMs   Int?
  params       String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
}

model Setting {
  key   String @id
  value String
}

model DemoJob {
  id          String    @id @default(uuid())
  leadId      Int?
  status      String    @default("pending")   // pending | running | completed | failed
  finalPath   String?
  error       String?
  inputData   Json
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

model Pipeline {
  id        String   @id @default(uuid())
  name      String
  isDefault Boolean  @default(false)
  stages    Stage[]
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id             String   @id @default(uuid())
  name           String
  order          Int
  winProbability Int      @default(0) // 0-100 percentage
  color          String   @default("#94a3b8") // Default slate/grey hex
  pipelineId     String
  pipeline       Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads          Lead[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([pipelineId])
  @@index([order])
}
