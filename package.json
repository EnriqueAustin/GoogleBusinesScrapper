{
  "name": "google-business-scraper",
  "version": "1.0.0",
  "description": "Google Maps business scraper with web dashboard for lead generation",
  "main": "server.js",
  "scripts": {
    "setup": "node scripts/setup.js",
    "reset": "node scripts/reset-db.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:api": "node --watch --watch-path=server.js --watch-path=src server.js",
    "dev:worker": "node --watch --watch-path=src src/worker.js",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:frontend\"",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "google-maps",
    "scraper",
    "lead-generation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bullmq": "^5.70.1",
    "chalk": "^4.1.2",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fs-extra": "^11.3.4",
    "ioredis": "^5.10.0",
    "multer": "^2.1.0",
    "playwright": "^1.59.1",
    "playwright-core": "^1.50.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "concurrently": "^9.2.1",
    "prisma": "^5.22.0"
  }
}
